{"mode":"Text","hardwareTarget":"brain","textContent":"#vex:disable=repl code\nfrom vex import *\nimport sys\nimport select\n\nbrain = Brain()\ncontroller = Controller()\n\nleft_motor = Motor(Ports.PORT1, False)\nright_motor = Motor(Ports.PORT6, True)\n\ndef perform_happy_dance():\n    brain.screen.clear_screen()\n    brain.screen.set_cursor(1, 1)\n    brain.screen.print(\"STATUS: HAPPY\")\n    \n    for _ in range(3):\n        left_motor.spin(FORWARD, 60, PERCENT)\n        right_motor.spin(REVERSE, 60, PERCENT)\n        wait(0.28, SECONDS)\n        left_motor.spin(REVERSE, 60, PERCENT)\n        right_motor.spin(FORWARD, 60, PERCENT)\n        wait(0.28, SECONDS)\n        \n    left_motor.spin(FORWARD, 75, PERCENT)\n    right_motor.spin(FORWARD, 75, PERCENT)\n    wait(0.75, SECONDS)\n    left_motor.spin(REVERSE, 75, PERCENT)\n    right_motor.spin(REVERSE, 75, PERCENT)\n    wait(0.75, SECONDS)\n    \n    left_motor.spin(FORWARD, 70, PERCENT)\n    right_motor.spin(REVERSE, 70, PERCENT)\n    wait(1.1, SECONDS)\n    \n    left_motor.stop()\n    right_motor.stop()\n\ndef perform_stop():\n    brain.screen.clear_screen()\n    brain.screen.set_cursor(1, 1)\n    brain.screen.print(\"STATUS: STOPPED\")\n    left_motor.stop()\n    right_motor.stop()\n\ndef start_forward():\n    brain.screen.clear_screen()\n    brain.screen.set_cursor(1, 1)\n    brain.screen.print(\"STATUS: FORWARD\")\n    left_motor.spin(FORWARD, 50, PERCENT)\n    right_motor.spin(FORWARD, 50, PERCENT)\n\ndef start_circle():\n    brain.screen.clear_screen()\n    brain.screen.set_cursor(1, 1)\n    brain.screen.print(\"STATUS: CIRCLING\")\n    left_motor.spin(FORWARD, 50, PERCENT)\n    right_motor.spin(REVERSE, 50, PERCENT)\n\nbrain.screen.clear_screen()\nbrain.screen.set_cursor(1, 1)\nbrain.screen.print(\"VIRTUAL CTRL READY\")\n\nwhile True:\n    cmd = None\n\n    # 1. Direct Physical Controller Button Checks\n    if controller.buttonEUp.pressing():\n        cmd = \"forward\"\n    elif controller.buttonEDown.pressing():\n        cmd = \"spin\"\n    elif controller.buttonFUp.pressing():\n        cmd = \"happy\"\n    elif controller.buttonFDown.pressing():\n        cmd = \"stop\"\n\n    # 2. Non-blocking USB Serial Input Check\n    if select.select([sys.stdin], [], [], 0)[0]:\n        line = sys.stdin.readline()\n        if line:\n            cmd = line.strip().lower()\n\n    # 3. Action Processing\n    if cmd:\n        if \"ping\" in cmd:\n            print(\"PONG_OK\")\n            brain.screen.clear_screen()\n            brain.screen.set_cursor(1, 1)\n            brain.screen.print(\"SETUP TEST: OK!\")\n        elif \"happy\" in cmd:\n            perform_happy_dance()\n            brain.screen.clear_screen()\n            brain.screen.set_cursor(1, 1)\n            brain.screen.print(\"VIRTUAL CTRL READY\")\n        elif \"stop\" in cmd:\n            perform_stop()\n            brain.screen.clear_screen()\n            brain.screen.set_cursor(1, 1)\n            brain.screen.print(\"VIRTUAL CTRL READY\")\n        elif \"forward\" in cmd:\n            start_forward()\n        elif \"spin\" in cmd:\n            start_circle()\n\n    wait(20, MSEC)","textLanguage":"python","robotConfig":[],"slot":0,"platform":"IQ","sdkVersion":"20230818.11.00.00","appVersion":"4.68.1","fileFormat":"2.0.0","targetBrainGen":"Second","v5SoundsEnabled":false,"aiVisionSettings":{"colors":[],"codes":[],"tags":true,"AIObjects":true,"AIObjectModel":[],"aiModelDropDownValue":null}}