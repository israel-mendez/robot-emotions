{"mode":"Text","hardwareTarget":"brain","textContent":"#region VEXcode Generated Robot Configuration\nfrom vex import *\nimport urandom\nimport math\n\n# Brain should be defined by default\nbrain=Brain()\n\n# Robot configuration code\nbrain_inertial = Inertial()\n\n\n\n# generating and setting random seed\ndef initializeRandomSeed():\n    wait(100, MSEC)\n    xaxis = brain_inertial.acceleration(XAXIS) * 1000\n    yaxis = brain_inertial.acceleration(YAXIS) * 1000\n    zaxis = brain_inertial.acceleration(ZAXIS) * 1000\n    systemTime = brain.timer.system() * 100\n    urandom.seed(int(xaxis + yaxis + zaxis + systemTime)) \n    \n# Initialize random seed \ninitializeRandomSeed()\n\n#endregion VEXcode Generated Robot Configuration\n# ---------------------------------------------------------------------------- #\n# Module:       main.py                                                        #\n# Project:      Tuned VEX IQ Clawbot - Split Arcade (\"Videogame\") Control      #\n# Target:       VEX IQ (2nd Generation) Brain & Controller                     #\n# Description:  Left Stick (AxisA) for Forward/Backward throttle,              #\n#               Right Stick (AxisC) for Left/Right steering,                   #\n#               L-Up / R-Up (L1/R1) for Claw Open/Close,                       #\n#               L-Down / R-Down (L2/R2) for Arm Raise/Lower.                   #\n# ---------------------------------------------------------------------------- #\n\nfrom vex import *\n\n# ============================================================================ #\n# 1. HARDWARE INSTANTIATION (Standard VEX IQ Clawbot Ports)                    #\n# ============================================================================ #\nbrain = Brain()\ncontroller = Controller()\n\n# VEX IQ Motor Syntax: Motor(Port, Reversed_Boolean)\nleft_motor  = Motor(Ports.PORT1,  False)\nright_motor = Motor(Ports.PORT6,  True)   # Reversed for right chassis side\nclaw_motor  = Motor(Ports.PORT4,  False)\narm_motor   = Motor(Ports.PORT10, False)\n\n# Disable any background graphical controller loops\nremote_control_code_enabled = False\n\n# ============================================================================ #\n# 2. TUNING CONSTANTS (Adjust these to customize driver feel)                  #\n# ============================================================================ #\nDEADBAND_PERCENT = 5          # Ignore joystick drift within [-5%, +5%]\nTHROTTLE_ALPHA = 0.70         # Cubic blend for forward/back (0.70 = smooth)\nTURN_ALPHA = 0.85             # Higher cubic blend on steering for precise aim\nTURN_SENSITIVITY = 0.80       # Caps max spin rate at 80% so turns aren't twitchy\n\nARM_UP_VELOCITY = 75          # High power to overcome gravity + payload\nARM_DOWN_VELOCITY = 45        # Controlled descent so the arm doesn't slam\nARM_MAX_TORQUE = 90           # Strong lifting force (%)\n\nCLAW_OPEN_VELOCITY = 60       # Crisp release speed (%)\nCLAW_CLOSE_VELOCITY = 75      # Firm clamping speed (%)\nCLAW_MAX_TORQUE = 60          # Capped at 60% to prevent gear stripping / stalls\n\n\ndef apply_tuned_curve(raw_input, deadband=DEADBAND_PERCENT, alpha=THROTTLE_ALPHA):\n    \"\"\"\n    Filters joystick noise via deadband and maps [-100, 100] input to a\n    blended cubic-linear output curve for high-precision low-speed control.\n    \"\"\"\n    if abs(raw_input) < deadband:\n        return 0.0\n\n    # Blended Cubic Formula: V(x) = alpha * (x^3 / 100^2) + (1 - alpha) * x\n    cubic_component = (raw_input ** 3) / 10000.0\n    tuned_velocity = (alpha * cubic_component) + ((1.0 - alpha) * raw_input)\n    return round(tuned_velocity, 2)\n\n\ndef configure_subsystems():\n    \"\"\"\n    Initializes motor stopping modes and torque limits prior to the main loop.\n    \"\"\"\n    left_motor.set_stopping(BRAKE)\n    right_motor.set_stopping(BRAKE)\n    left_motor.set_max_torque(100, PERCENT)\n    right_motor.set_max_torque(100, PERCENT)\n\n    arm_motor.set_stopping(HOLD)\n    arm_motor.set_max_torque(ARM_MAX_TORQUE, PERCENT)\n\n    claw_motor.set_stopping(HOLD)\n    claw_motor.set_max_torque(CLAW_MAX_TORQUE, PERCENT)\n\n    brain.screen.set_font(FontType.MONO15)\n    brain.screen.clear_screen()\n    brain.screen.set_cursor(1, 1)\n    brain.screen.print(\"Arcade Drive Ready\")\n\n\ndef driver_control_loop():\n    \"\"\"\n    Real-time 50Hz polling loop reading Videogame Split-Arcade controls:\n      - AxisA (Left Stick Up/Down): Forward / Reverse Throttle\n      - AxisC (Right Stick Left/Right): Steering\n      - ButtonLUp (L1) / ButtonRUp (R1): Claw Open / Close\n      - ButtonLDown (L2) / ButtonRDown (R2): Arm Raise / Lower\n    \"\"\"\n    configure_subsystems()\n\n    while True:\n        # -------------------------------------------------------------------- #\n        # 1. DRIVETRAIN CONTROL (Split Arcade: AxisA Throttle + AxisC Turn)    #\n        # -------------------------------------------------------------------- #\n        raw_throttle = controller.axisA.position()\n        raw_turn     = controller.axisC.position()\n\n        throttle = apply_tuned_curve(raw_throttle, DEADBAND_PERCENT, THROTTLE_ALPHA)\n        turn     = apply_tuned_curve(raw_turn, DEADBAND_PERCENT, TURN_ALPHA) * TURN_SENSITIVITY\n\n        # Arcade mixing equations\n        left_vel  = throttle + turn\n        right_vel = throttle - turn\n\n        # Proportional Desaturation: preserve turn ratio if sum exceeds 100%\n        max_magnitude = max(abs(left_vel), abs(right_vel))\n        if max_magnitude > 100.0:\n            left_vel  = (left_vel / max_magnitude) * 100.0\n            right_vel = (right_vel / max_magnitude) * 100.0\n\n        if left_vel == 0.0:\n            left_motor.stop()\n        else:\n            left_motor.spin(FORWARD, left_vel, PERCENT)\n\n        if right_vel == 0.0:\n            right_motor.stop()\n        else:\n            right_motor.spin(FORWARD, right_vel, PERCENT)\n\n        # -------------------------------------------------------------------- #\n        # 2. CLAW CONTROL (L-Up [L1] = Open, R-Up [R1] = Close)                #\n        # -------------------------------------------------------------------- #\n        if controller.buttonLUp.pressing():\n            claw_motor.spin(FORWARD, CLAW_OPEN_VELOCITY, PERCENT)\n        elif controller.buttonRUp.pressing():\n            claw_motor.spin(REVERSE, CLAW_CLOSE_VELOCITY, PERCENT)\n        else:\n            claw_motor.stop()\n\n        # -------------------------------------------------------------------- #\n        # 3. ARM CONTROL (L-Down [L2] = Raise, R-Down [R2] = Lower)            #\n        # -------------------------------------------------------------------- #\n        if controller.buttonLDown.pressing():\n            arm_motor.spin(FORWARD, ARM_UP_VELOCITY, PERCENT)\n        elif controller.buttonRDown.pressing():\n            arm_motor.spin(REVERSE, ARM_DOWN_VELOCITY, PERCENT)\n        else:\n            arm_motor.stop()\n\n        # -------------------------------------------------------------------- #\n        # 4. LOOP TIMING (20ms = 50Hz update rate)                             #\n        # -------------------------------------------------------------------- #\n        wait(20, MSEC)\n\n\n# Launch the tuned driver control loop\ndriver_control_loop()","textLanguage":"python","robotConfig":[],"slot":1,"platform":"IQ","sdkVersion":"20230818.11.00.00","appVersion":"4.68.1","fileFormat":"2.0.0","targetBrainGen":"Second","v5SoundsEnabled":false,"aiVisionSettings":{"colors":[],"codes":[],"tags":true,"AIObjects":true,"AIObjectModel":[],"aiModelDropDownValue":null}}